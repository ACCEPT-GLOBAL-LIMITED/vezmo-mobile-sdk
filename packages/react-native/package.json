{
  "name": "@vezmopay/react-native",
  "version": "0.1.0",
  "description": "Vezmo checkout for React Native and Expo apps: a native payment sheet for cards, Apple Pay, Google Pay, pay-later methods, UPI and Pix.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "vezmo-react-native-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "app.plugin.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @vezmopay/react-native-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "expo",
    "ios",
    "android",
    "payments",
    "checkout",
    "vezmo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACCEPT-GLOBAL-LIMITED/vezmo-mobile-sdk.git"
  },
  "author": "Vezmo <me@saifagl.com> (https://vezmo.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ACCEPT-GLOBAL-LIMITED/vezmo-mobile-sdk/issues"
  },
  "homepage": "https://github.com/ACCEPT-GLOBAL-LIMITED/vezmo-mobile-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.2",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "expo": ">=52.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.79.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "VezmoReactNativeSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.vezmo.reactnative"
    },
    "ios": {
      "components": {
        "VezmoPaymentElementView": {
          "className": "VezmoPaymentElementView"
        },
        "VezmoCardFlowView": {
          "className": "VezmoCardFlowView"
        }
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "vezmo-react-native-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ]
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "jest"
    ],
    "version": "0.63.1"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  }
}
